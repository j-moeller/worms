options {
	directory "/var/cache/bind";

	// Listen only on the services-bridge address (never on the management NIC).
	listen-on port 53 { {{ dns_listen_address }}; 127.0.0.1; };
	listen-on-v6 { none; };

	// The services bridge reaches this resolver (bounded by listen-on and the
	// host firewall); no zone transfers to anyone.
	allow-query { any; };
	allow-transfer { none; };

{% if internet_enabled | bool %}
	// Only while internet access is allowed: forward everything that is not a
	// local name upstream, and do not resolve it ourselves.
	recursion yes;
	allow-recursion { any; };
	forwarders { {% for forwarder in dns_forwarders %}{{ forwarder }}; {% endfor %}};
	forward only;
{% else %}
	// No upstream: authoritative for worms.internal only; refuse everything else.
	recursion no;
{% endif %}

	// Parity with the previous dnsmasq resolver, which did not validate DNSSEC.
	dnssec-validation no;

	// BIND's default cache may grow to 90% of RAM; this VM has 512 MB (floor
	// 256 MB with ballooning) and also runs apt while provisioning.
	max-cache-size 32m;
};

// Every channel is a bounded file, so that no client can fill the disk (S8): each at most
// 4 x 20 MB. Nothing goes to syslog: /var/log/syslog rotates weekly with no size limit, and
// failed lookups alone (a VM asking for an outside name, e.g. timesyncd's NTP pool, about
// 30 000 an hour from three devboxes) filled this VM's disk on 2026-11-18.
logging {
	channel query_log {
		file "/var/log/named/query.log" versions 3 size 20m;
		print-time yes;
		print-category yes;
		severity info;
	};
	channel named_log {
		file "/var/log/named/named.log" versions 3 size 20m;
		print-time yes;
		print-category yes;
		print-severity yes;
		severity info;
	};
	category queries { query_log; };
	// The queries that failed (SERVFAIL, refused names), beside the queries.
	category query-errors { query_log; };
	// Everything else named says: start, zones, denied queries, rate limits, resolver errors.
	category default { named_log; };
};
