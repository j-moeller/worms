{# One transaction (postgresql_query, autocommit off): revoke everything the
   roles hold in the schema, then grant exactly postgresql_table_privileges. #}
{% for role, grants in postgresql_table_privileges.items() %}
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM "{{ role }}";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM "{{ role }}";
{% for grant in grants %}
{% if grant.tables == 'ALL' %}
GRANT {{ grant.privs }} ON ALL TABLES IN SCHEMA public TO "{{ role }}";
{% else %}
GRANT {{ grant.privs }} ON {{ grant.tables | map('regex_replace', '^(.*)$', 'public."\\1"') | join(', ') }} TO "{{ role }}";
{% endif %}
{% endfor %}
{% for table in postgresql_append_only_tables | default([]) %}
{# Append only: whatever `tables: ALL` gave, no role reads, changes or removes a row. #}
REVOKE SELECT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON public."{{ table }}" FROM "{{ role }}";
{% endfor %}
{% for table, rule in (postgresql_restricted_columns | default({})).items() if role not in rule.readers %}
{# Restricted columns: a role that may read the table reads its other columns only. #}
DO $$
DECLARE
  others text;
BEGIN
  IF has_table_privilege('{{ role }}', 'public.{{ table }}', 'SELECT') THEN
    REVOKE SELECT ON public."{{ table }}" FROM "{{ role }}";
    SELECT string_agg(quote_ident(column_name), ', ' ORDER BY ordinal_position) INTO others
      FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = '{{ table }}'
        AND column_name <> ALL (ARRAY[{{ rule.columns | map('regex_replace', '^(.*)$', "'\\1'") | join(', ') }}]::text[]);
    EXECUTE format('GRANT SELECT (%s) ON public.%I TO %I', others, '{{ table }}', '{{ role }}');
  END IF;
END
$$;
{% endfor %}
{% endfor %}
{# Sequences behind the id columns of tables with INSERT (serial or identity). #}
DO $$
DECLARE
  grant_row record;
  seq text;
BEGIN
  FOR grant_row IN SELECT * FROM (VALUES
{% set rows = [] %}
{% for role, grants in postgresql_table_privileges.items() %}
{% for grant in grants if grant.tables != 'ALL' and 'INSERT' in grant.privs %}
{% for table in grant.tables %}
{% set _ = rows.append("('" ~ role ~ "', '" ~ table ~ "')") %}
{% endfor %}
{% endfor %}
{% endfor %}
    {{ rows | join(',\n    ') if rows else "(NULL, NULL)" }}
  ) AS t(role_name, table_name) WHERE role_name IS NOT NULL LOOP
    -- Only tables with an id column (django_session has none).
    CONTINUE WHEN NOT EXISTS (
      SELECT 1 FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = grant_row.table_name AND column_name = 'id');
    seq := pg_get_serial_sequence(format('public.%I', grant_row.table_name), 'id');
    IF seq IS NOT NULL THEN
      EXECUTE format('GRANT USAGE ON SEQUENCE %s TO %I', seq, grant_row.role_name);
    END IF;
  END LOOP;
END
$$;
{# The accounts a guarded role (the public dashboard) inserts are never staff
   or superuser: column grants cannot express that, a trigger can. Updates are
   covered by the column grants (is_staff / is_superuser are not granted). #}
CREATE OR REPLACE FUNCTION public.worms_users_guard() RETURNS trigger
LANGUAGE plpgsql AS $guard$
BEGIN
  IF (NEW.is_staff OR NEW.is_superuser) AND current_user::text = ANY (TG_ARGV) THEN
    RAISE EXCEPTION 'role % may not create staff or superuser accounts', current_user
      USING ERRCODE = 'insufficient_privilege';
  END IF;
  RETURN NEW;
END
$guard$;
DROP TRIGGER IF EXISTS worms_users_guard ON public.users;
{# A round deleted with everything under it (its attempts; their VMs, events, captures, logs and
   host jobs) for a role that may delete none of those rows itself: the dashboard (Staff -> Rounds,
   dashboard/views/staff_rounds.py round_delete). This one operation and nothing else: it refuses
   a round a `worms round start` session runs (its mark, rounds.session_seen_at, younger than
   Round.SESSION_STALE, 120 s), the row locked against a session starting. It runs as the
   tables' owner, the migrator; only postgresql_round_delete_roles may call it. The audit
   (competition_events) keeps its rows. 'deleted', 'running' or 'gone'. #}
CREATE OR REPLACE FUNCTION public.worms_delete_round(target bigint) RETURNS text
LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, public AS $delete$
DECLARE
  seen timestamptz;
BEGIN
  SELECT session_seen_at INTO seen FROM public.rounds WHERE id = target FOR UPDATE;
  IF NOT FOUND THEN
    RETURN 'gone';
  END IF;
  IF seen IS NOT NULL AND seen > now() - interval '120 seconds' THEN
    RETURN 'running';
  END IF;
  DELETE FROM public.run_events WHERE run_id IN (SELECT id FROM public.round_runs WHERE round_id = target)
    OR vm_id IN (SELECT id FROM public.virtual_machines WHERE round_id = target);
  DELETE FROM public.flag_captures WHERE round_id = target
    OR vm_id IN (SELECT id FROM public.virtual_machines WHERE round_id = target);
  DELETE FROM public.logging WHERE round_id = target
    OR run_id IN (SELECT id FROM public.round_runs WHERE round_id = target);
  DELETE FROM public.virtual_machines WHERE round_id = target
    OR run_id IN (SELECT id FROM public.round_runs WHERE round_id = target);
  DELETE FROM public.host_jobs WHERE run_id IN (SELECT id FROM public.round_runs WHERE round_id = target);
  DELETE FROM public.round_runs WHERE round_id = target;
  DELETE FROM public.rounds WHERE id = target;
  RETURN 'deleted';
END
$delete$;
ALTER FUNCTION public.worms_delete_round(bigint) OWNER TO "{{ postgres_migrator_name | default('django_migrator') }}";
REVOKE ALL ON FUNCTION public.worms_delete_round(bigint) FROM PUBLIC;
{% for role in postgresql_round_delete_roles | default([]) %}
GRANT EXECUTE ON FUNCTION public.worms_delete_round(bigint) TO "{{ role }}";
{% endfor %}
{% if postgresql_account_guard_roles %}
CREATE TRIGGER worms_users_guard BEFORE INSERT ON public.users FOR EACH ROW
  EXECUTE FUNCTION public.worms_users_guard({{ postgresql_account_guard_roles | map('regex_replace', '^(.*)$', "'\\1'") | join(', ') }});
{% endif %}
