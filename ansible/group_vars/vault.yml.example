# -----------------------------------------------------------------------------
# TEMPLATE for the encrypted secrets vault.
#
# 1. Copy this file to group_vars/vault.yml
# 2. Replace every value with a strong, unique secret
#      (e.g.  openssl rand -base64 32   for passwords,
#             python -c "import secrets;print(secrets.token_urlsafe(64))" for keys)
# 3. Encrypt it in place:
#      ansible-vault encrypt group_vars/vault.yml
# 4. Run playbooks with  --ask-vault-pass  (or --vault-password-file <file>).
#
# group_vars/vault.yml is git-ignored and must NEVER be committed unencrypted.
# -----------------------------------------------------------------------------

# PostgreSQL
vault_postgres_admin_password: "CHANGE_ME"
vault_postgres_migrator_password: "CHANGE_ME"
vault_django_dashboard_password: "CHANGE_ME"
vault_django_orchestrator_password: "CHANGE_ME"
vault_dbuser_logging_password: "CHANGE_ME"
vault_dbuser_network_monitor_password: "CHANGE_ME"
vault_dbuser_scoring_password: "CHANGE_ME"

# Internal CA
vault_pki_ca_passphrase: "CHANGE_ME"

# Django SECRET_KEY, one per application host.
vault_dashboard_secret_key: "CHANGE_ME"
vault_orchestrator_secret_key: "CHANGE_ME"

# Orchestrator REST API bearer token (dashboard -> sandbox VM power control).
vault_orchestrator_dashboard_token: "CHANGE_ME"

# Proxmox API token secret (the value half of a Proxmox API token).
vault_proxmox_api_token_value: "CHANGE_ME"

# Secret of the READ-ONLY Proxmox API token (PVEAuditor) the orchestrator uses
# to collect the topology for the dashboard (topology@pve!readonly by default,
# see proxmox_readonly_api_* in group_vars/all.yml).
vault_proxmox_readonly_api_token_value: "CHANGE_ME"
