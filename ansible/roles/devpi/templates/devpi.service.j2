[Unit]
Description=devpi PyPI cache
After=network.target

[Service]
Type=simple
User={{ devpi_user }}
Group={{ devpi_user }}
ExecStart={{ devpi_venv }}/bin/devpi-server \
  --host {{ devpi_host }} \
  --port {{ devpi_port }} \
{% if not (internet_enabled | bool) %}  --offline-mode \
{% endif %}  --serverdir {{ devpi_server_dir }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
