# Egress whitelist proxy. Only the listed upstream domains are reachable, and
# only from the private-internet subnet. This is the single VM with real
# internet egress; the caches (apt-cacher-ng, ...) forward through it, so even
# a compromised cache VM can only reach the whitelisted domains.
acl localnet src {{ egress_proxy_allow_network }}
acl allowed_domains dstdomain {{ egress_proxy_allowed_domains | join(' ') }}

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localnet allowed_domains
http_access deny all

http_port {{ egress_proxy_port }}
cache deny all
