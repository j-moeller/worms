#cloud-config
# First boot only: hostname, the SSH key, SSH hardening and (private-internet
# services) the data disk. Software is installed by the VM's Ansible role.
ssh_pwauth: false

hostname: ${hostname}

ssh_authorized_keys:
  - ${ssh_public_key}
%{ if data_mount != null ~}

# Dedicated data disk (virtio1) for the service's payload, kept apart from the
# OS disk.
disk_setup:
  /dev/vdb:
    table_type: gpt
    layout: true
    overwrite: false

fs_setup:
  - device: /dev/vdb1
    filesystem: ext4
    label: data
    overwrite: false

mounts:
  - [ LABEL=data, ${data_mount}, ext4, "defaults,nofail", "0", "2" ]
%{ endif ~}

runcmd:
  # SSH hardening (worms): key-only, no passwords, root only via the provisioned key.
  - printf 'PermitRootLogin prohibit-password\nPasswordAuthentication no\nKbdInteractiveAuthentication no\nChallengeResponseAuthentication no\nPubkeyAuthentication yes\nPermitEmptyPasswords no\n' > /etc/ssh/sshd_config.d/10-worms-hardening.conf
  - systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  - echo "done" > /tmp/cloud-config.done
