# Managed by Ansible (role ntp). Hardening drop-in for the packaged chrony unit,
# modeled on the application roles' pattern but ADJUSTED for an NTP server:
# chronyd binds the privileged port 123 and steers the system clock, so it keeps
# CAP_NET_BIND_SERVICE and CAP_SYS_TIME, is allowed the @clock syscalls, and
# does NOT set ProtectClock. Optional paths are prefixed with "-".
#
# Debian's chrony unit already ships its own hardening; this only tightens it.
# UNTESTED on a real VM: the ntp service is not currently deployed
# (opentofu/stacks/private_internet keeps it commented). Verify
# `systemctl status chrony` and `chronyc tracking` after enabling it.
[Service]
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/chrony
ReadWritePaths=-/var/log/chrony
ReadWritePaths=-/run/chrony
ProtectHome=tmpfs
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# NOT ProtectClock, and NOT PrivateDevices: chronyd must set the system clock
# (makestep / local stratum) and may read the RTC (/dev/rtc).
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# @clock: chronyd calls adjtimex/clock_settime to discipline the clock; those
# are not in @system-service.
SystemCallFilter=@system-service @clock
# Bind port 123 (CAP_NET_BIND_SERVICE), steer the clock (CAP_SYS_TIME), drop to
# the _chrony user (CAP_SETUID/CAP_SETGID). Everything else is dropped.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SETUID CAP_SETGID
# AF_NETLINK: chronyd watches interface changes; AF_INET6: the host has IPv6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
