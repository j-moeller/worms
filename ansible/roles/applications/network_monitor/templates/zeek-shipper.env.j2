# Managed by Ansible (role network_monitor). Root-owned, mode 0600; read by
# systemd before privileges are dropped.
ZEEK_LOG_DIR={{ network_monitor_log_dir }}
ZEEK_ARCHIVE_DIR={{ network_monitor_archive_dir }}
STATE_FILE={{ network_monitor_shipper_state_dir }}/state.json
EVENT_LOGS={{ network_monitor_event_logs | join(',') }}
MAX_FLOWS_PER_SECOND={{ network_monitor_max_flows_per_second }}
FLOW_BURST={{ network_monitor_flow_burst }}
MAX_EVENTS_PER_SECOND={{ network_monitor_max_events_per_second }}
EVENT_BURST={{ network_monitor_event_burst }}
MAX_EVENT_BYTES={{ network_monitor_max_event_bytes }}
REPORT_SECONDS={{ network_monitor_report_seconds }}

DB_HOST={{ network_monitor_db_host }}
DB_PORT={{ network_monitor_db_port }}
DB_NAME={{ network_monitor_db_name }}
DB_USER={{ network_monitor_db_user }}
DB_PASSWORD={{ network_monitor_db_password }}
DB_SSLMODE=verify-full
DB_SSLROOTCERT={{ network_monitor_db_sslrootcert }}
