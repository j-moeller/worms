#!/bin/sh
# Managed by Ansible (role round_agent). DO NOT EDIT.
#
#   worms-audit event internet_allowed [--data '{"by": "Internet.yml"}'] [--actor NAME]
#   worms-audit collect-gateway
#
# Records one of the node's events in the database (scripts/round_agent/events.py,
# docs/06-background-processes.md) as the node's events account, which may only append to
# ssh_gateway_logins and platform_events. The database's address comes from the
# agent's file, the account from its own. Best effort: a failure is printed and
# the exit code says so.
set -eu
set -a
. {{ round_agent_env_file }}
. {{ round_agent_events_env_file }}
set +a
cd {{ round_agent_repo_root }}
exec {{ round_agent_python }} -m round_agent.events "$@"
