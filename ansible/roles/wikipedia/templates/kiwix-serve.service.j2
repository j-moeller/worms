[Unit]
Description=Kiwix serve (offline Wikipedia)
After=network.target

[Service]
Type=simple
User={{ wikipedia_user }}
Group={{ wikipedia_user }}
ExecStart=/bin/sh -c '/usr/bin/kiwix-serve --port {{ wikipedia_port }} --address {{ wikipedia_host }} {{ wikipedia_data_dir }}/*.zim'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
