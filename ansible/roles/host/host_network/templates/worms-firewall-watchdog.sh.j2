#!/bin/bash
# Managed by Ansible (role host_network). DO NOT EDIT.
#
# Fail-safe for the untrusted VMs (sandbox AND devbox): the Proxmox firewall
# (proxmox-firewall) is the main enforcement between them and everything else.
# If it is not running, or a running sandbox/devbox VM has no rules in the guest
# ruleset, hard-stop ALL such VMs (qm stop kills the QEMU process; no guest
# cooperation needed). Devbox VMs are always-on but just as untrusted as the
# sandbox, so an uncontained one is stopped too (docs/security-assessment.md).
# Run every {{ host_fw_watchdog_interval }} by worms-firewall-watchdog.timer.
set -u

GUEST_TABLE="{{ host_fw_guest_table }}"

running_untrusted_vms() {
  pvesh get /cluster/resources --type vm --output-format json \
    | python3 -c "import json,sys; print(*(r['vmid'] for r in json.load(sys.stdin) if r.get('pool') in ('sandbox', 'devbox') and r.get('status') == 'running'))"
}

fail() {
  local vms
  vms=$(running_untrusted_vms)
  logger -t worms-firewall-watchdog -p auth.crit "$1; stopping sandbox/devbox VMs: ${vms:-none}"
  for vmid in $vms; do
    qm stop "$vmid" --skiplock 1 &
  done
  wait
  exit 1
}

systemctl is-active --quiet proxmox-firewall || fail "proxmox-firewall is not active"
nft list table inet worms >/dev/null 2>&1 || fail "host table inet worms missing"
nft list table bridge worms_bridge >/dev/null 2>&1 || fail "host table bridge worms_bridge missing"
ruleset=$(nft list table $GUEST_TABLE 2>/dev/null) || fail "guest firewall table ($GUEST_TABLE) missing"

for vmid in $(running_untrusted_vms); do
  grep -q "tap${vmid}i" <<<"$ruleset" || fail "no firewall rules for sandbox/devbox VM $vmid"
done
exit 0
