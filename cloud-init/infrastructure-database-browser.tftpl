#cloud-config

hostname: ${hostname}

ssh_authorized_keys:
  - ${ssh_public_key}
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINr4h1Wj5XEk650NCsfKFKRqH2JnR5Dqug39VUIn6stD jonas.moeller@tu-berlin-macpro

packages:
  - adminer
  - apache2
  - libapache2-mod-php
  - php-pgsql

write_files:
  - path: /etc/apache2/conf-available/adminer.conf
    permissions: '0644'
    content: |
      Alias /adminer /usr/share/adminer/adminer

      <Directory /usr/share/adminer>
          Require all granted
      </Directory>

runcmd:
  - echo "${secret}" > /tmp/secret

  - a2enconf adminer
  - systemctl restart apache2

  - echo "done" > /tmp/cloud-config.done