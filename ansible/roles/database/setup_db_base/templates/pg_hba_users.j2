{# TLS-only, scram-sha-256. Each application user may connect only from its own
   VM (/32); admin only from the Proxmox host, migrator only from the Django hosts. #}
{% for user in postgresql_users %}
hostssl    {{ postgres_db }}    {{ user.name }}    {{ user.cidr }}    scram-sha-256
{% endfor %}
{% for cidr in postgres_admin_cidrs %}
hostssl    {{ postgres_db }}    {{ postgres_admin_name }}    {{ cidr }}    scram-sha-256
{% endfor %}
{% for cidr in postgres_migrator_cidrs %}
hostssl    {{ postgres_db }}    {{ postgres_migrator_name }}    {{ cidr }}    scram-sha-256
{% endfor %}
