# {{ ansible_managed | default('Managed by Ansible') }}
{% if nginx_team_api %}
# Team API (dashboard/api.py, docs/team_api.md): rate limits per client
# address and per bearer token. The host DNATs the dashboard without SNAT, so
# $binary_remote_addr is the real client. The token zone keys on the raw
# Authorization header; it lives only in nginx's shared memory (nothing is
# logged), the same trust as the request itself.
limit_req_zone $binary_remote_addr zone=team_api_ip:10m rate={{ nginx_team_api_rate_per_ip }};
limit_req_zone $http_authorization zone=team_api_token:10m rate={{ nginx_team_api_rate_per_token }};
limit_conn_zone $binary_remote_addr zone=team_api_conn:10m;

{% endif %}
{% if nginx_login_rate %}
# Sign-ins (dashboard only): a password guesser gets {{ nginx_login_rate }} per
# address. Only POSTs count (the map's empty key is not limited), so viewing
# the page is free. The staff pages live on this site too.
map $request_method $worms_login_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $worms_login_key zone=login:10m rate={{ nginx_login_rate }};

{% endif %}
server {
    listen 80;
    listen [::]:80;

    server_name {{ tls_dns_name }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{ tls_dns_name }};

    ssl_certificate {{ tls_cert_path }};
    ssl_certificate_key {{ tls_key_path }};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Django gets the Host header exactly as the browser sent it ($http_host,
    # port included), not $host (which drops the port). Its CSRF check
    # compares the browser's Origin (https://name:port) with https://<Host>;
    # reached through a forwarded port (an SSH tunnel, a NAT on another port)
    # $host would make every login POST fail. ALLOWED_HOSTS still validates
    # the name (the port is ignored there).

{% if nginx_team_api %}
    location /api/ {
        limit_except GET {
            deny all;
        }
        limit_req zone=team_api_ip burst={{ nginx_team_api_burst_per_ip }} nodelay;
        limit_req zone=team_api_token burst={{ nginx_team_api_burst_per_token }} nodelay;
        limit_conn team_api_conn {{ nginx_team_api_connections_per_ip }};
        limit_req_status 429;
        limit_conn_status 429;
        client_max_body_size 1k;
        proxy_read_timeout {{ nginx_team_api_timeout }};
        # The bearer token is a credential: never in the access log's URL
        # (it is a header), and responses are not cached.
        proxy_pass http://unix:/run/django/django.sock;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

{% endif %}
    # The site's CSS/JS, collected at deploy (role django_app). Revalidated on
    # every load (ETag), so a deploy's new styles show at once. A location
    # with add_header does not inherit the server's, hence HSTS again.
    location /static/ {
        alias {{ nginx_django_static_root }}/;
        expires epoch;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
    }

{% if nginx_login_rate %}
    location = /login/ {
        limit_req zone=login burst={{ nginx_login_burst }} nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/django/django.sock;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

{% endif %}
{% if nginx_upload_max_body_size %}
    # Worm uploads: a plain multipart form; Django caps the file itself at
    # MAX_UPLOAD_SIZE (dashboard/views/uploads.py). Everywhere else keeps
    # nginx's default 1 MiB body limit.
    location = /upload/ {
        client_max_body_size {{ nginx_upload_max_body_size }};
        proxy_pass http://unix:/run/django/django.sock;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

{% endif %}
    location / {
        proxy_pass http://unix:/run/django/django.sock;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
