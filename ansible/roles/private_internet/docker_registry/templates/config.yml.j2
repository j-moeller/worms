version: 0.1
log:
  level: info
storage:
  filesystem:
    rootdirectory: {{ docker_registry_data_dir }}
{% if not (internet_enabled | bool) %}
  # Filled while internet access is allowed; read-only from then on: a client
  # cannot plant an image for later rounds (docs/07-security.md, S2).
  maintenance:
    readonly:
      enabled: true
{% endif %}
http:
  addr: 0.0.0.0:{{ docker_registry_port }}
