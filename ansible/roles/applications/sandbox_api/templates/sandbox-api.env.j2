# Managed by Ansible (role sandbox_api). Root-owned, mode 0600; read by systemd
# before privileges are dropped.
SANDBOX_API_KIND={{ sandbox_api_kind }}
MAX_BODY_BYTES={{ sandbox_api_max_body_bytes }}
TEAM_RATE_PER_MINUTE={{ sandbox_api_team_rate_per_minute }}
TEAM_BURST={{ sandbox_api_team_burst }}
TEAM_BAN_AFTER={{ sandbox_api_team_ban_after }}
TEAM_BAN_SECONDS={{ sandbox_api_team_ban_seconds }}
LOG_MAX_BYTES={{ sandbox_api_log_max_bytes }}
LOG_MAX_DEPTH={{ sandbox_api_log_max_depth }}
LOG_MAX_ITEMS={{ sandbox_api_log_max_items }}

# The running team's uuid, written by the round agent at deploy. No access
# token is used here anymore (only one team runs at a time).
CURRENT_TEAM_FILE={{ sandbox_api_current_team_file }}
# Devbox attribution: `<source-ip> <team-uuid>` per line (docs/devbox.md). A
# submission from a listed devbox-gateway address is a devbox submission for
# that team, independent of the running round.
DEVBOX_TEAMS_FILE={{ sandbox_api_devbox_teams_file }}
CLIENT_IP_HEADER=X-Client-IP

DB_HOST={{ sandbox_api_db_host }}
DB_PORT={{ sandbox_api_db_port }}
DB_NAME={{ sandbox_api_db_name }}
DB_USER={{ sandbox_api_db_user }}
DB_PASSWORD={{ sandbox_api_db_password }}
DB_SSLMODE=verify-full
DB_SSLROOTCERT={{ sandbox_api_db_sslrootcert }}
DB_POOL_SIZE={{ sandbox_api_db_pool_size }}
