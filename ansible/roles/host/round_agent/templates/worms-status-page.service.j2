# Managed by Ansible (role round_agent). DO NOT EDIT.
#
# The public status page, status.{{ worms_environment.public_name }} (src/worms_cli/statuspage.py):
# every component checked from here, the result recorded and copied to the dashboard VM's nginx.
# worms-node-run: the workspace's code, and the WORMS key in a private ssh-agent (the checks log in
# to the VMs as `worms login` does). The history stays in /var/lib/worms/status.
[Unit]
Description=worms status page: check every component, publish status.{{ worms_environment.public_name }}
After=network-online.target

[Service]
Type=oneshot
Environment=STATUS_PUBLIC_NAME={{ worms_environment.public_name }}
Environment=PYTHONPATH={{ round_agent_repo_root }}/src
ExecStart={{ round_agent_node_run }} . "python3 -m worms_cli.statuspage run"
TimeoutStartSec=55
Nice=10
