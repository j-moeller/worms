# Managed by Ansible (role: django_app). Root-owned, mode 0600.
# Read by systemd (as root) before privileges are dropped, so the unprivileged
# application user never reads secrets from disk.
PRODUCTION=1
DJANGO_SETTINGS_MODULE={{ django_settings_module }}
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts }}
DJANGO_STATIC_ROOT={{ django_static_root }}
{% if django_media_root %}
DJANGO_MEDIA_ROOT={{ django_media_root }}
{% endif %}

DB_NAME={{ django_db_name }}
DB_HOST={{ django_db_host }}
DB_PORT={{ django_db_port }}
DB_SSLMODE={{ django_db_sslmode }}
DB_SSLROOTCERT={{ django_db_sslrootcert }}

DB_USER={{ django_db_user }}
DB_PASSWORD={{ django_db_password }}

{% if django_run_migrations | bool %}
DB_MIGRATOR_USER={{ postgres_migrator_name }}
DB_MIGRATOR_PASSWORD={{ postgres_migrator_password }}
{% endif %}
{% for key, value in django_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
