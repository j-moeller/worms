# Listen only on the services-bridge address (never on the management NIC).
listen-address={{ dns_listen_address }}
listen-address=127.0.0.1
bind-dynamic

# Don't read /etc/hosts unless you explicitly want that.
no-hosts

# Don't inherit upstream resolvers from resolv.conf.
no-resolv

# Local DNS entries (only for VMs that exist in OpenTofu, see group_vars/dns.yml).
{% for entry in dns_entries if entry.group is not defined or groups[entry.group] | default([]) | length > 0 %}
address=/{{ entry.name }}/{{ entry.ip }}
{% endfor %}

{% if internet_enabled | bool %}
# Only while internet access is allowed: forward everything else upstream.
server=1.1.1.1
server=1.0.0.1
{% endif %}

# Don't forward names that are explicitly local.
domain={{ dns_domain }}
local=/{{ dns_domain }}/

# Useful operational defaults.
# no-resolv
cache-size=1000
domain-needed
bogus-priv

log-queries
log-facility=/var/log/dnsmasq.log