# Listen only on the internal interface/address.
listen-address=10.2.0.11
listen-address=10.3.0.11
bind-interfaces

# Don't read /etc/hosts unless you explicitly want that.
no-hosts

# Don't inherit upstream resolvers from resolv.conf.
no-resolv

# Local DNS entries.
{% for entry in dns_entries %}
address=/{{ entry.name }}/{{ entry.ip }}
{% endfor %}

# Forward everything else upstream.
server=1.1.1.1
server=1.0.0.1

# Don't forward names that are explicitly local.
domain={{ dns_domain }}
local=/{{ dns_domain }}/

# Useful operational defaults.
# no-resolv
cache-size=1000
domain-needed
bogus-priv

log-queries
log-facility=/var/log/dnsmasq.log