#cloud-config

hostname: ${hostname}
fqdn: ${hostname}.service

packages:
  - apt-cacher-ng
  - nginx

users:
  - name: user
    groups:
      - sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/apt-cacher-ng/acng.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Listen on all interfaces (restrict with firewall rules)
      BindAddress: 127.0.0.1

      # Default cache port
      Port: 3142

      # Cache storage
      CacheDir: /var/cache/apt-cacher-ng

      # Enable logging
      LogDir: /var/log/apt-cacher-ng

      # Do not allow remote administration
      Remap-remote: file:remap-remote.conf

      # Keep package files
      ExTreshold: 4

      # Restrict repositories
      ForceManaged: 1

  - path: /etc/apt-cacher-ng/security.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable web admin from untrusted networks
      AdminAuth: disabled

runcmd:
  - echo "${secret}" > /tmp/secret
  - systemctl enable apt-cacher-ng
  - systemctl restart apt-cacher-ng
  - echo "done" > /tmp/cloud-config.done

final_message: |
  CoreDNS installation complete.