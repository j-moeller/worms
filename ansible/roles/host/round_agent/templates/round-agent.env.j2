# Managed by Ansible (role round_agent). Root-owned, 0600; read by systemd.
REPO_ROOT={{ round_agent_repo_root }}
PYTHONPATH={{ round_agent_repo_root }}/scripts:{{ round_agent_repo_root }}/src
# The agent is the node, whatever /root/.worms/config says: a WORMS_SSH there
# (laptop mode) made its `worms step devbox-apply` look for a laptop's inventory.
# The environment wins over that file (src/worms_cli/config.py).
WORMS_SSH=

DB_HOST={{ round_agent_db_host }}
DB_PORT={{ round_agent_db_port }}
DB_NAME={{ round_agent_db_name }}
DB_USER={{ round_agent_db_user }}
DB_PASSWORD={{ round_agent_db_password }}
DB_SSLMODE=verify-full
DB_SSLROOTCERT={{ round_agent_db_sslrootcert }}

DASHBOARD_HOST={{ round_agent_dashboard_host }}
DASHBOARD_MEDIA_ROOT={{ round_agent_dashboard_media_root }}
SCORING_HOST={{ round_agent_scoring_host }}
LOGGING_HOST={{ round_agent_logging_host }}
SSH_GATEWAY_HOST={{ round_agent_ssh_gateway_host }}
SSH_GATEWAY_USER={{ round_agent_ssh_gateway_user }}
SSH_KEY={{ round_agent_ssh_key }}
SERVICE_HOSTS={{ round_agent_service_hosts | join(',') }}

# OpenTofu (sandbox / devbox stacks; docs/07-security.md, "Secrets").
TF_VAR_proxmox_api_url={{ round_agent_tofu_api_url }}
TF_VAR_proxmox_api_token={{ round_agent_tofu_api_token }}
TF_VAR_proxmox_instance={{ round_agent_tofu_node }}
TF_VAR_ssh_public_key={{ round_agent_ssh_key }}.pub
# The provider's SSH login to this node (snippets): loopback, on this system's sshd
# port (group_vars/all.yml, worms_environments).
TF_VAR_node_ssh_address=127.0.0.1
TF_VAR_node_ssh_port={{ worms_environment.operator_ssh_port }}
TF_VAR_llm_access_ip={{ llm_access_ip }}
